{
  "name": "fooderabot-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run optimize-images && tsc -b && vite build",
    "optimize-images": "node scripts/optimize-images.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "check-render": "vite build --ssr scripts/render-smoke.tsx --outDir .smoke --logLevel error && node .smoke/render-smoke.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.35.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.6"
  }
}
