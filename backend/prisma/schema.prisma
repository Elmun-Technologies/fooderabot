generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationType {
  STAND
  GUEST
}

enum RegistrationStatus {
  PENDING
  SYNCED
  FAILED
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   BigInt   @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?

  // Language chosen explicitly in the bot (uz | ru | en) - set before the web
  // app ever opens, so the whole flow (bot messages + web app) can adapt to it.
  language String?

  // First-touch UTM attribution, captured from the /start deep-link payload.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  startPayload String?

  // Marketing nudge sequence for users who opened the bot but never finished
  // registering. 0 = none sent yet; bumped as each stage in the schedule fires.
  nudgeStage  Int       @default(0)
  nudgeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registration Registration?
}

model Registration {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  type     RegistrationType
  language String // uz | ru | en - language chosen inside the web app

  position        String
  fullName        String
  phone           String? // required for STAND registrations; optional for GUEST
  companyName     String?
  companyYears    String?
  companyActivity String?
  spaceNeeded     String? // STAND only, square meters
  willAttend      Boolean? // GUEST only

  // Stage-2 additions — never drop, only widen.
  // `city` is captured at submission time (Stand step 2).
  city        String?
  // `leadScore` is a 0-100 number produced by the rule-based scoring engine
  // (services/leadScoring.ts) right after the row is saved.
  leadScore   Int      @default(0)
  // `leadTier` is the categorical bucket ("HOT" | "WARM" | "COLD") so the
  // admin can filter fast without recomputing the score.
  leadTier    String?

  status       RegistrationStatus @default(PENDING)
  amoLeadId    Int?
  amoContactId Int?
  syncError    String?

  // Post-registration marketing follow-up sequence (thank-you / share nudge).
  followUpStage  Int       @default(0)
  followUpSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
