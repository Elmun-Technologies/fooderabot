# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Public HTTPS URL of the deployed web app (Telegram Mini App requires HTTPS)
WEBAPP_URL=https://expo.example.com

# --- Server ---
PORT=3000
# Comma separated list of origins allowed to call the API (usually just WEBAPP_URL)
CORS_ORIGIN=https://expo.example.com

# --- Database ---
DATABASE_URL=postgresql://fooderabot:fooderabot@localhost:5432/fooderabot?schema=public

# --- amoCRM ---
# Long-lived access token generated in amoCRM (Settings -> Integrations -> your private integration)
AMOCRM_BASE_URL=https://yourdomain.amocrm.ru
AMOCRM_ACCESS_TOKEN=
# Pipeline/status the lead should be created in. Leave empty to use the account default.
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID_STAND=
AMOCRM_STATUS_ID_GUEST=

# Custom field IDs from your amoCRM account (Settings -> Leads -> Fields).
# Leave any of these empty and the value will simply be skipped as a custom field
# (it is always still included in the lead's note/description as a fallback).
AMOCRM_FIELD_POSITION=
AMOCRM_FIELD_COMPANY_NAME=
AMOCRM_FIELD_COMPANY_YEARS=
AMOCRM_FIELD_COMPANY_ACTIVITY=
AMOCRM_FIELD_SPACE_NEEDED=
AMOCRM_FIELD_LANGUAGE=
AMOCRM_FIELD_REG_TYPE=
AMOCRM_FIELD_WILL_ATTEND=
AMOCRM_FIELD_TELEGRAM_USERNAME=
AMOCRM_FIELD_UTM_SOURCE=
AMOCRM_FIELD_UTM_MEDIUM=
AMOCRM_FIELD_UTM_CAMPAIGN=
AMOCRM_FIELD_UTM_CONTENT=
AMOCRM_FIELD_UTM_TERM=

# --- UTM deep-link map (optional) ---
# JSON map from short /start payload code -> utm values, e.g.
# {"ig":{"source":"instagram","medium":"social","campaign":"expo2026"}}
# Codes not found here fall back to the "a__b__c" convention (source__medium__campaign),
# or are used as the raw utm_source if there is no "__" separator.
UTM_MAP_JSON={}
