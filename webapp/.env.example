# Webapp environment variables (Vite)
# Copy to .env and fill in values

# API base URL (leave empty if same origin — nginx proxy handles /api/)
VITE_API_BASE_URL=

# Share URL for "share with friends" button
VITE_SHARE_URL=https://t.me/FooderaExpoBot

# Meta Pixel (Facebook/Instagram reklama tracking)
# https://business.facebook.com/events_manager → Pixel ID
VITE_META_PIXEL_ID=

# Google Analytics 4
# https://analytics.google.com → Admin → Property → Measurement ID
VITE_GA_MEASUREMENT_ID=
